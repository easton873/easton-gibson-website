<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }} · {% endif %}{{ site.name }}</title>
  <meta name="description" content="{{ description or site.tagline }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600;800;900&family=JetBrains+Mono:wght@400;600&display=swap">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="{{ bodyClass or 'theme-main' }}" {% if hue %}style="--h: {{ hue }}"{% endif %}>
  {% include "partials/nav.njk" %}
  <main>{{ content | safe }}</main>
  {% include "partials/footer.njk" %}
</body>
</html>
